Universe = vanilla
getenv = True
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = results
executable = run_make_hist_bin.sh
output = logs/job_$(Process).out
error  = logs/job_$(Process).err
log    = logs/job_$(Process).log
